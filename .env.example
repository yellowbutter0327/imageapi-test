# demo: API 키 없이 로컬 샘플로 실행 / live: 네이버 API 사용
SEARCH_MODE=demo

# 서버 전용. NEXT_PUBLIC_ 또는 REACT_APP_ 접두사를 사용하지 마세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional shared cache/quota for live deployments (Upstash Redis REST).
# Without these, live search is uncached and has no shared application quota.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SEARCH_REQUESTS_PER_MINUTE=60
SEARCH_REQUESTS_PER_DAY=2000
